{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Delete",
  "version": "0.1.0",
  "description": "Select multiple chats in ChatGPT and delete them in bulk.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["contentScript-simple.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
